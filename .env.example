# Backend Supabase do Desafio Diário (ticket 12) — nada de chaves hardcoded.
# Copie para `.env` e preencha com os valores do seu projeto:
#   https://supabase.com/dashboard → projeto → Settings → API keys
#
# SUPABASE_URL     — URL do projeto (https://<project-ref>.supabase.co)
# SUPABASE_ANON_KEY— chave pública "anon" (segura no cliente; só expõe o
#                    contrato RPC do Desafio Diário, ver supabase/README.md)

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>

# No cliente Expo/React Native as variáveis embutidas no bundle exigem o
# prefixo EXPO_PUBLIC_ (usadas a partir do ticket 13):
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
