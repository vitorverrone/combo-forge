# Backend Supabase do Desafio Diário (ticket 12) — nada de chaves hardcoded.
# Copie para `.env` e preencha com os valores do seu projeto:
#   https://supabase.com/dashboard → projeto → Settings → API keys
#
# SUPABASE_URL     — URL do projeto (https://<project-ref>.supabase.co)
# SUPABASE_ANON_KEY— chave pública "anon" (segura no cliente; só expõe o
#                    contrato RPC do Desafio Diário, ver supabase/README.md)

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>

# No cliente Expo/React Native as variáveis embutidas no bundle exigem o
# prefixo EXPO_PUBLIC_ (usadas a partir do ticket 13):
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# RevenueCat (ticket 14 — loja cosmética). Chave pública do app (em
# app.revenuecat.com → Settings → API Keys). Sem ela, a loja usa o provider
# dev (compra simulada) — compra real exige development build.
EXPO_PUBLIC_REVENUECAT_API_KEY=<revenuecat public sdk key>

# AdMob (ticket 16 — anúncio recompensado da tentativa extra do Desafio
# Diário; ticket 02 — intersticial entre Runs; banner-01 — banner full-width).
# Ad unit IDs são por PLATAFORMA (ca-app-pub-.../...) e por FORMATO — um ad
# unit de rewarded não serve anúncio como intersticial nem como banner, são
# produtos diferentes no dashboard do AdMob (Apps → Combo Forge → Ad units →
# Add ad unit, uma vez por formato). E o EAS injeta env por ambiente (não por
# plataforma), então cada combinação plataforma×formato tem a sua própria
# variável — selecionada em runtime via Platform.OS. Sem o env do formato/
# plataforma atual, o provider dev responde (anúncio sempre concluído) — o
# jogo funciona integralmente sem anúncios. Em dev builds o SDK usa o TestId
# oficial de cada formato (não gasta impressão real).
#
# IMPORTANTE (app.json): o config plugin usa os Test App IDs do Google
# (androidAppId/iosAppId). Antes do release de cada plataforma, troque pelo
# App ID real da sua conta AdMob — sem um App ID válido o app nativo crasha
# no start, e com App ID de teste o Ad Unit real não serve anúncios (só os
# de teste). O wizard scripts/setup-admob.sh captura App ID + ad unit e grava
# em app.json + .env automaticamente.

# Recompensado (tentativa extra do Desafio Diário):
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID_ANDROID=<admob rewarded ad unit id (android)>
# Quando publicar na App Store, descomente e preencha com o ad unit do iOS:
# EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT_ID_IOS=<admob rewarded ad unit id (ios)>

# Intersticial (tela cheia entre Runs, a cada 2 Runs concluídas — ticket 02).
# SEPARADO do ad unit de rewarded acima: mesma conta AdMob, produto diferente.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ID_ANDROID=<admob interstitial ad unit id (android)>
# Quando publicar na App Store, descomente e preencha com o ad unit do iOS:
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ID_IOS=<admob interstitial ad unit id (ios)>

# Banner full-width de 50dp no rodapé de todas as telas (ticket banner-01).
# Ad unit de banner também é SEPARADA das outras duas no dashboard. Em dev
# builds o componente usa o TestId oficial de banner adaptativo (sempre
# carrega); em produção usa o ad unit real — sem env da plataforma, o banner
# fica oculto e o jogo segue intacto.
EXPO_PUBLIC_ADMOB_BANNER_AD_UNIT_ID_ANDROID=<admob banner ad unit id (android)>
# Quando publicar na App Store, descomente e preencha com o ad unit de banner do iOS:
# EXPO_PUBLIC_ADMOB_BANNER_AD_UNIT_ID_IOS=<admob banner ad unit id (ios)>

# Liga anúncio REAL explicitamente — default (ausente/qualquer valor != "true")
# é anúncio de TESTE, mesmo em build "production" do EAS (necessário pro
# .aab + submit ao Play Console). O teste fechado exige no mínimo 12
# testers; marcar cada um como test device no AdMob pra evitar risco de
# tráfego inválido não compensa nessa escala — então o teste fechado roda só
# com TestIds. Ligar pra true SÓ no ambiente EAS usado pro lançamento
# público de fato (open testing/produção no Play Console):
#   eas env:set production --name EXPO_PUBLIC_ADMOB_LIVE_ADS --value true
EXPO_PUBLIC_ADMOB_LIVE_ADS=false
