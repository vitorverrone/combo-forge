# Google Play service account key (eas submit) — secret, never commit
google-play-service-account.json

# Firebase Analytics config (ADR 0007) — não é segredo crítico, mas fica fora
# do git pra não acoplar o repo a um projeto Firebase específico
google-services.json
GoogleService-Info.plist

# Firebase Admin SDK service account key — segredo real (acesso admin ao
# projeto Firebase), nunca commitar. Nome padrão do console:
# <project-id>-firebase-adminsdk-<hash>.json
*firebase-adminsdk*.json

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Per-project skill installation (symlinks in .claude/skills/ point into
# .agents/skills/ with absolute paths tied to this machine; skills-lock.json
# is the reinstall record) — not portable, regenerable, not committed.
.agents/
agent/
.claude/
skills-lock.json
.codex/
.omo/

# Emulator screenshots
emulator-screenshot*.png

