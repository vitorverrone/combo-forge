{
  "expo": {
    "name": "Combo Forge",
    "slug": "combo-forge",
    "version": "1.0.0",
    "supportsTablet": true,
    "orientation": "portrait",
    "scheme": "comboforge",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.combocardforge.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/icon-ios.png",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "itms-apps",
          "itms-apps"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.combocardforge.app",
      "backgroundColor": "#161120",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#161120"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-audio",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7753200620000515~2190419729",
          "iosAppId": "ca-app-pub-7753200620000515~6706283181"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20"
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      "./plugins/withKotlinVersionPin",
      "./plugins/withAndroidResizable",
      "./plugins/withOrientationLockCompat",
      "expo-font",
      "expo-localization",
      "expo-updates",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161120",
          "image": "./assets/icon-ios.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier is used to measure ad performance. Combo Forge never shows personalized ads."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e1c84c4c-b160-4fa8-ae87-4054fd87299c"
      }
    },
    "owner": "vitorverrones-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e1c84c4c-b160-4fa8-ae87-4054fd87299c",
      "checkAutomatically": "NEVER"
    }
  }
}