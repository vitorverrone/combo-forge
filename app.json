{
  "expo": {
    "name": "Combo Forge",
    "slug": "combo-forge",
    "version": "1.0.0",
    "supportsTablet": true,
    "orientation": "portrait",
    "scheme": "comboforge",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#161120"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.combocardforge.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["itms-apps"]
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.combocardforge.app",
      "backgroundColor": "#161120",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#161120"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-audio",
      "@react-native-firebase/app",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7753200620000515~2190419729",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20"
          }
        }
      ],
      "./plugins/withKotlinVersionPin",
      "./plugins/withAndroidResizable",
      "./plugins/withOrientationLockCompat",
      "expo-font",
      "expo-localization",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "e1c84c4c-b160-4fa8-ae87-4054fd87299c"
      }
    },
    "owner": "vitorverrones-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e1c84c4c-b160-4fa8-ae87-4054fd87299c",
      "checkAutomatically": "NEVER"
    }
  }
}